# Dependencies
node_modules/

# TypeScript & Installer Build Output
dist/
dist-installer/

# SQLite Database Files
*.db
*.db-journal
*.db-shm
*.db-wal

# Input & Organized PDFs (Keep directory structure)
input/*
!input/.gitkeep
organized/*
!organized/.gitkeep

# Runtime registry mirror (personal document metadata)
registry.json

# Runtime manual-decision feedback log (personal document metadata)
manual_decisions.json

# Personal taxonomy overlay — auto-created categories/subcategories derived from your own
# documents (real bank branches, employers, etc.). categories.json (committed) stays a clean,
# generic starter taxonomy; this file is where your real data actually lives. See
# src/infrastructure/categories-store.ts for how the two are merged.
.categories.private.json

# Local user settings (contains private folder paths)
settings.json

# Personal prompt overlay — real employers, bank product codes, scan filename prefixes and
# clinics injected into the committed, generic prompts/ templates at prompt-build time. The
# templates stay publishable; this file is where your own signals live. See
# prompts.private.json.example and src/domain/prompt-personalization.ts.
.prompts.private.json

# MCP HTTP transport auth token (auto-generated on first `npm run mcp` if absent — see
# src/infrastructure/mcp/mcp-server.ts). Grants full tool access over the network; never commit.
.mcp-api-token

# Zip packages built by the MCP package_documents tool / REST package-zip endpoint.
__packages/

# Environment variables & Logs
.env
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Single-instance server lock
.server.lock
.scan.lock

# Tesseract OCR language data (large binaries, runtime-downloaded)
*.traineddata

# Operating System Files
.DS_Store
Thumbs.db

# Vendored plugin (own git repo, not a submodule of this project)
.claude/plugins/superpowers/

# Windows directory junctions INTO the vendored plugin above. Git follows junctions, so leaving
# these tracked committed 100 copies of third-party code (obra/superpowers, MIT (c) 2025 Jesse
# Vincent) into this repo without its LICENSE. The junctions still work locally; they just are
# not ours to redistribute. Single source of truth for skills: docs/skills.md.
# No trailing slash: on Unix these junctions are SYMLINKS (git treats them as files, not dirs),
# so the dir-only pattern below would miss them and they'd show up as untracked symlinks.
.claude/skills
docs/skills

# Local worktree sessions
.claude/worktrees/

# Subagent-driven-development scratch workspace (ledgers, briefs, review packages)
.superpowers/

# Throwaway one-off debug/probe scripts (not part of the app)
scratch/

# Social media drafts/posts about the project (personal, not project source)
social/

# Python (paddleocr-server)
paddleocr-server/__pycache__/
paddleocr-server/.pytest_cache/

# Vision Lab crop benchmark artifacts — generated contact sheets and previews (hundreds of MB).
# Regenerate with scripts/crop-bench.ts / crop-score.ts; never commit.
crop-bench-out/
.tmp-gt/
