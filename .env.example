# Copy this file to .env and adjust as needed. All values are optional — the app works with
# zero configuration, defaulting to folders inside the project root. .env itself is gitignored.

# Project root override. Defaults to the directory you run the app from (process.cwd()).
# Only needed if you run the compiled output from somewhere other than the project root.
# PDF_TRIAGE_BASE_DIR=

# Where the app watches for incoming documents to triage. Defaults to <project-root>/input.
# Can also be set via settings.json (input_dir) from the Settings modal in the UI.
# PDF_INPUT_DIR=

# Where triaged documents get moved/organized into. Defaults to <project-root>/organized.
# Can also be set via settings.json (output_root_dir) from the Settings modal in the UI.
# PDF_OUTPUT_DIR=

# Path to the SQLite database file. Defaults to <project-root>/pdf_triage.db.
# PDF_DB_PATH=

# Path to the JSON registry mirror. Defaults to <project-root>/registry.json.
# PDF_REGISTRY_PATH=

# Ollama server host. Defaults to http://127.0.0.1:11434 (local Ollama).
# OLLAMA_HOST=

# Ollama model for classification. Only qwen3.5:9b is supported (Golden Rule #14) —
# anything else is rejected and falls back to qwen3.5:9b.
# OLLAMA_MODEL=qwen3.5:9b

# Ollama model for embeddings.
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Ollama model for the Vision Lab image-to-PDF pipeline (orientation/crop detection). Only
# minicpm-v4.6:latest is supported — anything else is rejected and falls back. Env-only,
# no settings.json equivalent.
# OLLAMA_VISION_MODEL=minicpm-v4.6:latest

# Web dashboard port.
# PORT=3971

# Web dashboard bind address. Defaults to 127.0.0.1 (localhost only) — this server has no
# authentication, so binding wider exposes document contents and destructive actions to
# anyone who can reach it. Only change if you specifically want LAN access.
# PDF_TRIAGE_HOST=127.0.0.1

# Vision Lab standalone diagnostic server port (npm run vision:dev), separate from PORT above.
# VISION_LAB_PORT=3179

# MCP Streamable HTTP transport (npm run mcp) — lets non-stdio agents (OpenAI Agents SDK,
# another machine on the LAN) call the same tools Claude Desktop/Code use over stdio. Unlike
# PDF_TRIAGE_HOST above, this defaults to LAN-reachable (0.0.0.0) and is guarded by a bearer
# token instead (auto-generated into the gitignored .mcp-api-token on first start, printed to
# the console). Set MCP_HTTP_HOST=127.0.0.1 to restrict it to this machine only.
# MCP_HTTP_PORT=3972
# MCP_HTTP_HOST=0.0.0.0

# PaddleOCR local service host. Defaults to http://127.0.0.1:8871. See paddleocr-server/README.md
# for one-time setup — Node auto-spawns this service if it isn't already running.
# PADDLEOCR_HOST=

# Command used to auto-spawn the PaddleOCR service if PADDLEOCR_HOST is unreachable. Override
# if your Python environment needs an explicit interpreter path (e.g. a venv).
# PADDLEOCR_SPAWN_CMD=python paddleocr-server/main.py

# How many pages of a SCANNED pdf get rendered and OCR'd. Defaults to 10. Each page is a real OCR
# round-trip (seconds), so this is a quality/throughput trade-off: text on pages beyond the cap is
# genuinely absent from raw_text, the classifier, the Markdown and search. Truncation always logs a
# WARN naming the skipped pages — grep "Canvas OCR truncated" if a long scan looks incomplete.
# OCR_MAX_PAGES=10

# Log file location and rotation. PDF_TRIAGE_LOG_DIR moves logs/triage_debug.log without moving the
# rest of the data dir (the test suite uses it to keep out of the real log). The log rotates at
# PDF_TRIAGE_LOG_MAX_BYTES, keeping PDF_TRIAGE_LOG_RETAIN generations; 0 bytes disables rotation.
# PDF_TRIAGE_LOG_DIR=
# PDF_TRIAGE_LOG_MAX_BYTES=5242880
# PDF_TRIAGE_LOG_RETAIN=3

# UI/prompt language: FR or EN. Defaults to FR.
# SYSTEM_LANGUAGE=FR
